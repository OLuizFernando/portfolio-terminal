# Unit da API. Instalar com:
#
#   sudo cp deploy/portfolio-api.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now portfolio-api
#
# Ajuste User/WorkingDirectory se o clone não estiver em /srv/portfolio.
#
# O `deploy-portfolio` reinstala esta unit sozinho quando ela muda, então editar
# a cópia em /etc/systemd/system/ é trabalho perdido: edite aqui.

[Unit]
Description=portfolio API (reads /proc for the terminal site)
After=network.target

[Service]
Type=exec
User=oluizfernando
WorkingDirectory=/srv/portfolio
ExecStart=/srv/portfolio/.venv/bin/python -m uvicorn api.main:app --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=5

# O JSONL da telemetria. O systemd cria /var/lib/portfolio com o dono certo e
# abre a escrita ali apesar do ProtectSystem=strict — que é justamente o ponto:
# a API escreve num diretório, e em nenhum outro lugar do disco.
StateDirectory=portfolio

# Só escuta em 127.0.0.1 e quem fala com o mundo é o nginx. Estas restrições são
# baratas e fecham o que a API não precisa: ganhar privilégio, ver o /home de
# alguém, ou escrever fora do StateDirectory.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/srv/portfolio

# A API existe para ler /proc e /sys — sem isto, nada aqui funciona.
ProtectProc=default
ProcSubset=all

[Install]
WantedBy=multi-user.target
